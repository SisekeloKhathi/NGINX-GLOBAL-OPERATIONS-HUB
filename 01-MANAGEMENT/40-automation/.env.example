DB_HOST=localhost
DB_PORT=5432
DB_NAME=ops_db
DB_USER=admin
DB_PASSWORD=changeme

# REASON: Optional webhook URL for Slack/Discord/Teams. If empty,
# webhook actions are skipped and events are logged to Postgres only.
